{
  "publisher": "s-h-a-d-o-w",
  "name": "pnpm-catalog-lens-plus",
  "displayName": "Catalog Lens Plus",
  "version": "1.0.200001",
  "forkOf": {
    "name": "pnpm-catalog-lens",
    "version": "1.0.2"
  },
  "private": true,
  "scripts": {
    "build": "tsdown",
    "dev": "nr build --watch",
    "prepare": "nr update",
    "update": "vscode-ext-gen --output src/generated/meta.ts --scope catalogLens",
    "lint": "eslint .",
    "vscode:prepublish": "nr build",
    "ext:publish": "vsce publish --no-dependencies",
    "package": "vsce package --no-dependencies",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp"
  },
  "packageManager": "pnpm@12.7.0+sha512.9c56477e360068d6e9dca6a92efb4e46b3dc5a52fcebf3d84d78b9736c0ded589a561621a52f68219a7a39facc63cdc079c3226ef9c9d5f02b79f74e69a807b6",
  "description": "Show versions inline for PNPM/Yarn/Bun catalogs",
  "author": "Andreas Opferkuch <andreas.opferkuch@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/s-h-a-d-o-w/vscode-pnpm-catalog-lens-plus#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/s-h-a-d-o-w/vscode-pnpm-catalog-lens-plus"
  },
  "bugs": {
    "url": "https://github.com/s-h-a-d-o-w/vscode-pnpm-catalog-lens-plus/issues"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/index.cjs",
  "icon": "res/icon.png",
  "files": [
    "LICENSE.md",
    "dist/*",
    "res/*"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "activationEvents": [
    "workspaceContains:pnpm-workspace.yaml",
    "workspaceContains:.yarnrc.yml",
    "workspaceContains:bun.lock",
    "workspaceContains:bun.lockb"
  ],
  "contributes": {
    "commands": [
      {
        "category": "Catalog Lens",
        "title": "Toggle",
        "command": "catalogLens.toggle"
      },
      {
        "category": "Catalog Lens",
        "title": "Go to Definition",
        "command": "catalogLens.gotoDefinition"
      },
      {
        "category": "PNPM Catalog Lens",
        "title": "Toggle",
        "command": "pnpmCatalogLens.toggle"
      },
      {
        "category": "PNPM Catalog Lens",
        "title": "Go to Definition",
        "command": "pnpmCatalogLens.gotoDefinition"
      },
      {
        "title": "Upgrade Version",
        "command": "catalogLens.upgradeVersion"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "catalogLens.upgradeVersion",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "properties": {
        "catalogLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inlay hints"
        },
        "catalogLens.hover": {
          "type": "boolean",
          "default": true,
          "description": "Show dependency info on hover"
        },
        "catalogLens.namedCatalogsColors": {
          "type": "boolean",
          "default": true,
          "description": "Give each named catalog a unique color"
        },
        "catalogLens.namedCatalogsColorsSalt": {
          "type": "string",
          "default": "catalog-lens",
          "description": "A random string to adding as the salt for the named catalogs colors"
        },
        "catalogLens.namedCatalogsLabel": {
          "type": "boolean",
          "default": true,
          "description": "Show a small label for named catalog in the inlay hint"
        },
        "pnpmCatalogLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inlay hints"
        },
        "pnpmCatalogLens.hover": {
          "type": "boolean",
          "default": true,
          "description": "Show dependency info on hover"
        },
        "pnpmCatalogLens.namedCatalogsColors": {
          "type": "boolean",
          "default": true,
          "description": "Give each named catalog a unique color"
        },
        "pnpmCatalogLens.namedCatalogsColorsSalt": {
          "type": "string",
          "default": "catalog-lens",
          "description": "A random string to adding as the salt for the named catalogs colors"
        },
        "pnpmCatalogLens.namedCatalogsLabel": {
          "type": "boolean",
          "default": true,
          "description": "Show a small label for named catalog in the inlay hint"
        }
      }
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.0.0",
    "@antfu/ni": "^28.1.0",
    "@babel/core": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/traverse": "^7.28.6",
    "@babel/types": "^7.28.6",
    "@reactive-vscode/vueuse": "^0.4.1",
    "@types/babel__core": "^7.20.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.7",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "^3.7.1",
    "bumpp": "^10.4.0",
    "eslint": "^9.39.2",
    "eslint-plugin-format": "^1.3.0",
    "fast-npm-meta": "^2.1.0",
    "find-up": "^8.0.0",
    "js-yaml": "^4.1.1",
    "ovsx": "^0.10.8",
    "reactive-vscode": "^0.4.1",
    "tsdown": "^0.18.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.17",
    "vscode-ext-gen": "^1.5.1",
    "vsxpub": "^0.1.3",
    "yaml-eslint-parser": "^1.3.2"
  }
}
